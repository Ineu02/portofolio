# ------------------------------------------------------------------
# Contact form email delivery (Resend — https://resend.com)
# Copy this file to `.env.local` for local dev, and set the same
# variables in your Vercel project settings for production.
# The contact form works without these (it logs instead of emailing),
# but no email is delivered until all three are set.
#
# This file is committed. Leave every value blank — real keys and
# addresses belong in .env.local, which is gitignored.
# ------------------------------------------------------------------

# Your Resend API key (starts with re_)
RESEND_API_KEY=

# Where contact messages should be delivered
CONTACT_TO_EMAIL=

# A verified sender in your Resend account
CONTACT_FROM_EMAIL=
